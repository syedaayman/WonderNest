# WonderNest backend configuration example.
# Copy to .env and fill in real values locally. Never commit a real key.

# --- Database -------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/wondernest.db

# --- Auth -----------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
DEMO_PASSWORD=Demo@12345

# --- AI tutor (Google Gemini) ---------------------------------------------------
# Create a key at https://aistudio.google.com/apikey and paste it here locally.
# On the hosting provider set the same name in Settings -> Environment variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional tuning (defaults shown).
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024
AI_RATE_LIMIT_REQUESTS=12
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_MESSAGE_CHARS=1200

# --- App ------------------------------------------------------------------------
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
